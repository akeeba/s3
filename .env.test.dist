# S3 test environments for the integration tests. Copy this file to .env.test (git-ignored) and edit it.
#
# Each environment is a group of variables sharing a prefix, e.g. DEFAULT_*, C2_*, MINIO_*. Any variable named
# <PREFIX>_ACCESS_KEY (with a <PREFIX>_BUCKET) defines an environment. `composer test:integration` discovers them all
# and runs the whole integration suite against each one in turn. Real environment variables override this file.
#
# Settings per environment (required ones first):
#   <PREFIX>_ACCESS_KEY, _SECRET_KEY, _BUCKET
#   _REGION                    Region of the bucket (empty for services which have none, e.g. with v2 signatures)
#   _SIGNATURE                 v4 (default) or v2
#   _ENDPOINT                  Custom endpoint of an S3-compatible service; leave out for Amazon S3
#   _DUALSTACK, _PATH_ACCESS   true/false (default false). Path-style access puts the bucket in the URL path
#   _SSL                       true/false (default true)
#   _VIRTUAL_HOSTS             false if bucket.endpoint host names do not resolve to the service (default true)
#   _ALTERNATE_DATE_FORMAT, _USE_HTTP_DATE_HEADER, _PRE_SIGNED_BUCKET_IN_URL    Library feature flags, default false
#   _PERMISSIONS               full (default), no-delete (archival buckets) or write-only. Each value runs a
#                              different set of test classes, matching what the key pair is allowed to do
#   _CREATE_2100_FILES         false skips the slow "list thousands of files" tests (default true)
#   _CONTAINER                 true if the environment is the Docker container of IntegrationTest/docker; the runner
#                              starts it when needed and stops it afterwards (unless it was already running)
#   _STORAGE_CLASSES           all (default) or a comma-separated list of the storage classes the service accepts
#                              (MinIO: REDUCED_REDUNDANCY); the others are skipped
#   _SKIP                      true leaves the environment defined but out of the runs
#
# Run one environment only:  composer test:integration -- --env=C2
# Skip the slow tests:       composer test:integration -- --quick
# See the available ones:    composer test:integration -- --list
#
# Recommended coverage, see https://docs.aws.amazon.com/general/latest/gr/s3.html for the regions:
#   * us-east-1, which often has special meaning in the API
#   * eu-west-1, the non-default region
#   * eu-central-1 (and every newer region), which only allows v4 signatures
#   * a third party S3-compatible service, ideally one with v2 and one with v4 signatures
# Also worth trying: write-only keys, buckets with dots / uppercase / international letters, access from within EC2.

# Amazon S3 proper: the canonical target, since not all of its quirks are documented
DEFAULT_ACCESS_KEY=AK0123456789BCDEFGHI
DEFAULT_SECRET_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
DEFAULT_BUCKET=mybucket
DEFAULT_REGION=eu-west-1
DEFAULT_SIGNATURE=v4
DEFAULT_DUALSTACK=false
DEFAULT_PATH_ACCESS=false
DEFAULT_SSL=true

# Wasabi. Its v4 implementation reads the date only from the X-Amz-Date header; the endpoint, the region and the
# region of the bucket must all match, or the tests fail.
#WASABI_ACCESS_KEY=THE_ACCESS_KEY
#WASABI_SECRET_KEY=VERY_SECRET_MUCH_WOW
#WASABI_BUCKET=bucketname
#WASABI_REGION=eu-central-2
#WASABI_ENDPOINT=s3.eu-central-2.wasabisys.com

# Synology C2. It implements Amazon's documentation of v4 signatures rather than how they work in practice (dates
# formatted per their "ISO 8601" reading). The endpoint is shown next to each bucket in the C2 Object Manager; the
# part before `.s3.` is the REGION you need with v4 signatures.
# C2 rejects the REDUCED_REDUNDANCY and INTELLIGENT_TIERING storage classes (InvalidStorageClass), hence STORAGE_CLASSES.
#C2_ACCESS_KEY=THE_ACCESS_KEY
#C2_SECRET_KEY=VERY_SECRET_MUCH_WOW
#C2_BUCKET=bucketname
#C2_REGION=eu-002
#C2_ENDPOINT=eu-002.s3.synologyc2.net
#C2_STORAGE_CLASSES=STANDARD

# MinIO in Docker: `composer minio:up` starts it with an empty `test` bucket, `composer minio:down` removes it.
# `composer test:minio` does all of it for you. It is plain HTTP, and only path-style access works (virtual-hosted
# URLs need MinIO's MINIO_DOMAIN and a DNS wildcard), hence VIRTUAL_HOSTS=false. The credentials are those in
# IntegrationTest/docker/compose.yml. MinIO only knows the STANDARD and REDUCED_REDUNDANCY storage classes. CONTAINER=true makes the runner start and stop the container when needed.
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=test
MINIO_REGION=us-east-1
MINIO_SIGNATURE=v4
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_PATH_ACCESS=true
MINIO_SSL=false
MINIO_VIRTUAL_HOSTS=false
MINIO_STORAGE_CLASSES=REDUCED_REDUNDANCY
MINIO_CONTAINER=true

# The same, with v2 signatures
MINIO_V2_ACCESS_KEY=minioadmin
MINIO_V2_SECRET_KEY=minioadmin
MINIO_V2_BUCKET=test
MINIO_V2_REGION=us-east-1
MINIO_V2_SIGNATURE=v2
MINIO_V2_ENDPOINT=127.0.0.1:9000
MINIO_V2_PATH_ACCESS=true
MINIO_V2_SSL=false
MINIO_V2_VIRTUAL_HOSTS=false
MINIO_V2_STORAGE_CLASSES=REDUCED_REDUNDANCY
MINIO_V2_CONTAINER=true
